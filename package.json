{
	"name": "@ultraq/react-icu-message-formatter",
	"version": "0.13.0-beta.1",
	"description": "React wrapper for the lightweight ICU message formatter",
	"author": "Emanuel Rabina <emanuelrabina@gmail.com> (http://www.ultraq.net.nz/)",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/ultraq/react-icu-message-formatter.git"
	},
	"keywords": [
		"react",
		"icu",
		"message",
		"format",
		"intl",
		"i18n"
	],
	"type": "module",
	"exports": {
		"types": "./dist/react-icu-message-formatter.d.ts",
		"default": "./dist/react-icu-message-formatter.js"
	},
	"files": [
		"dist",
		"CHANGELOG.md"
	],
	"sideEffects": false,
	"scripts": {
		"lint": "eslint \"**/*.{ts,tsx}\"",
		"test": "vitest",
		"build": "rimraf dist && npm run build:dist",
		"build:dist": "tsc",
		"typecheck": "attw --pack .",
		"prepublishOnly": "npm run build"
	},
	"dependencies": {
		"@ultraq/string-utils": "^3.1.0"
	},
	"peerDependencies": {
		"@ultraq/icu-message-formatter": "0.16.0",
		"react": "16.8.0 - 19"
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "^0.18.5",
		"@eslint-react/eslint-plugin": "^5.30.3",
		"@testing-library/jest-dom": "^8.0.0",
		"@testing-library/react": "^16.3.3",
		"@tsconfig/node-lts": "^26.0.1",
		"@tsconfig/node-ts": "^23.6.5",
		"@types/node": "^26.6.6",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@ultraq/icu-message-formatter": "^0.16.0-beta.3",
		"@vitest/coverage-v8": "^5.1.0",
		"eslint": "^10.15.0",
		"eslint-config-ultraq": "^5.0.0-beta.1",
		"eslint-import-resolver-typescript": "^4.4.5",
		"globals": "^17.14.0",
		"happy-dom": "^21.0.4",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"rimraf": "^6.1.4",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.2",
		"vitest": "^5.1.0"
	},
	"engines": {
		"node": ">=22"
	}
}
